{
  "name": "aulainicial",
  "version": "4.10.1",
  "main": "index.js",
  "scripts": {
    "lint": "node --check server.js && node --check index.js && node --check admin.js",
    "test": "node test/smoke.js && node test/registro-guardar.test.js",
    "build:win": "node ./node_modules/@yao-pkg/pkg/lib-es5/bin.js . --targets node22-win-x64 --output bin/AulaInicial.exe",
    "build:linux": "node ./node_modules/@yao-pkg/pkg/lib-es5/bin.js . --targets node22-linux-x64 --output bin/AulaInicial-linux",
    "build:macos-arm64": "node ./node_modules/@yao-pkg/pkg/lib-es5/bin.js . --targets node22-macos-arm64 --output bin/AulaInicial-macos-arm64",
    "build:macos-x64": "node ./node_modules/@yao-pkg/pkg/lib-es5/bin.js . --targets node22-macos-x64 --output bin/AulaInicial-macos-x64",
    "build:macos": "npm run build:macos-arm64 && npm run build:macos-x64",
    "build": "npm run build:win && npm run build:linux && npm run build:macos"
  },
  "bin": "server.js",
  "pkg": {
    "assets": [
      "*.html",
      "*.css",
      "*.js",
      "assets/**/*",
      "favicon.ico",
      "!server.js"
    ]
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "open": "^8.4.2",
    "puppeteer-core": "^22.15.0",
    "qrcode": "^1.5.4",
    "readline-sync": "^1.4.10",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.14.2"
  }
}
