{
  "name": "aulainicial",
  "version": "4.0.0",
  "main": "index.js",
  "scripts": {
    "lint": "node --check server.js && node --check index.js && node --check admin.js",
    "test": "node test/smoke.js",
    "build:win": "pkg . --targets node22-win-x64 --output bin/AulaInicial.exe",
    "build:linux": "pkg . --targets node22-linux-x64 --output bin/AulaInicial-linux",
    "build": "npm run build:win && npm run build:linux"
  },
  "bin": "server.js",
  "pkg": {
    "assets": [
      "*.html",
      "*.css",
      "*.js",
      "!server.js"
    ]
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "open": "^8.4.2",
    "puppeteer-core": "^22.15.0",
    "qrcode": "^1.5.4",
    "readline-sync": "^1.4.10",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.14.2"
  }
}
