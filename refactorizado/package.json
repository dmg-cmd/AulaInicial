{
  "name": "aulainicial-refactorizado",
  "version": "4.8.2",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && vite build && node scripts/copy-html.js",
    "start": "node dist/server.js",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "build:win": "pkg dist/server.js --targets node22-win-x64 --output bin/AulaInicial.exe",
    "build:linux": "pkg dist/server.js --targets node22-linux-x64 --output bin/AulaInicial-linux",
    "build:binaries": "npm run build:win && npm run build:linux"
  },
  "bin": "dist/server.js",
  "pkg": {
    "assets": [
      "dist/public/**/*",
      "src/config/**/*"
    ],
    "scripts": "dist/**/*.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "open": "^10.1.0",
    "qrcode": "^1.5.4",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/qrcode": "^1.5.5",
    "@yao-pkg/pkg": "^6.14.2",
    "eslint": "^9.4.0",
    "globals": "^15.4.0",
    "playwright": "^1.44.0",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.0.0",
    "vite": "^5.3.0",
    "vitest": "^1.6.0",
    "tsx": "^4.15.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}